# This SSH config is managed by chezmoi.

# --- GitHub Configuration (All Systems) ---
# Use the dedicated automation key for all connections to github.com.
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/chezmoi_automation_id_ed25519
  IdentitiesOnly yes

# --- Homelab ---
# amd64 build box (LXC 100 on pve-04), the docker context named `builder`.
# Keepalives because the loop harness runs `make validate` through this tunnel:
# without them a dropped connection leaves the docker client waiting forever
# instead of failing (cost 4.5 hours of a stalled loop on 2026-09-12).
Host 192.168.35.124 docker-builder
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes

# TrueNAS SCALE (VM 501 on pve-01): BigPool, the app host for Navidrome and
# Audiobookshelf. The public key lives in the TrueNAS UI (Local Users -> jahnke
# -> Authorized Keys), not in chezmoi: the NAS is an appliance and never runs
# the provisioning playbook (apt is disabled there).
Host truenas 192.168.35.127
  HostName 192.168.35.127
  User jahnke
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# NVIDIA DGX Spark (spark-5e8d) on the LAN.
Host spark
  HostName 192.168.35.224
  User jahnke
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

{{ if eq .chezmoi.os "darwin" -}}
# --- macOS Specific Configuration ---
# Store SSH key passphrases in the macOS Keychain.
Host *
  UseKeychain yes
{{ end -}}
