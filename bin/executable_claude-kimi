#!/usr/bin/env bash
# Claude Code backed by Moonshot's Anthropic-compatible endpoint (Kimi).
# A second cheap engine for unattended loops, and a third non-Claude voice
# for the council; plain `claude` stays 100% Anthropic. Same shape as
# claude-ds. See the "Overnight Looping Runbook" vault note.
set -euo pipefail
if [ -z "${KIMI_API_KEY:-}" ]; then
  source "$HOME/.zprofile" 2>/dev/null || true   # cron has no login env
fi
: "${KIMI_API_KEY:?KIMI_API_KEY not set (expected via ~/.zprofile)}"
export ANTHROPIC_BASE_URL="https://api.moonshot.ai/anthropic"
export ANTHROPIC_AUTH_TOKEN="$KIMI_API_KEY"
# Models available on this account (2026-09-06): kimi-k2.6, kimi-k2.7-code,
# kimi-k2.7-code-highspeed, kimi-k3. Override with KIMI_MODEL / KIMI_FAST_MODEL.
export ANTHROPIC_MODEL="${KIMI_MODEL:-kimi-k2.7-code}"
export ANTHROPIC_SMALL_FAST_MODEL="${KIMI_FAST_MODEL:-kimi-k2.7-code-highspeed}"
# Kimi K2.x has a 256k context window.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=256000
exec claude "$@"
